<table class="calendar table table-responsive">
    <thead>
    <tr>
        <th colspan="2" class="head previous">{% if prevHref|default %}<a href="{{ prevHref }}" title="{{ prevTitle }}">{{ prevLink }}</a>{% else %}&nbsp;{% endif %}</th>
        <th colspan="3" class="head current">{{ current }}</th>
        <th colspan="2" class="head next">{% if nextHref|default %}<a href="{{ nextHref }}" title="{{ nextTitle }}">{{ nextLink }}</a>{% else %}&nbsp;{% endif %}</th>
    </tr>
    </thead>
    <tbody>
    {% for week in weeks %}
      {% set d = 0 %}{# Nummer des Wochentags. Mo == 1 usw. #}
        <tr>
            {% for day in week %}
              {% set d = d + 1 %}
              {% if 'empty' in day.class %}
                {# leerer Tag des Vor- oder des Folgemonats #}
              {%  else %}
                <tr class="day_{{ d }} {{ day.events ? 'noevents': 'events' }}">
                <td colspan="7" {% if day.class|default %} class="{{ day.class }}"{% endif %}>
                  <div class="header">{{ day.timestamp|date('D')|replace({'Mon': 'Mo', 'Tue': 'Di', 'Wed': 'Mi', 'Thu': 'Do', 'Fri': 'Fr', 'Sat': 'Sa', 'Sun': 'So'}) }}.
                      {{ day.timestamp|date(contao.date_format) }}</div>
                  {% for event in day.events %}
                    <div class="event cal_{{ event.parent }}{{ event.class }}">
                      <a href="{{ event.href }}" title="{{ event.title }} ({% if event.day|default %}{{ event.day }}, {% endif %}{{ event.date }}{% if event.time|default %} {{ event.time }}{% endif %})"{{ event.target }}>
                        {% if event.time|default %} {{ event.time }}{% endif %} {{ event.link }}
                      </a>
                    </div>
                  {% endfor %}
                </td>
              {% endif %}
            {% endfor %}
      </tr>
    {% endfor %}
    </tbody>
</table>
