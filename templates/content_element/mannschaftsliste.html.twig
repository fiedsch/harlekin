{% extends "@Contao/content_element/mannschaftsliste.html.twig" %}
{% use "@Contao/component/_figure.html.twig" %}

{% block content %}

  {% for verbandId, ligen in mannschaftsliste  %}
    {% if verbaende[verbandId].logo is not empty %}
          {% set logo_options = {
              metadata: { alt: 'Logo '~verbaende[verbandId].name },
              options: {
                  img_attr: { class: 'img-thumbnail' }
              }
          } %}
          {% set image = figure(verbaende[verbandId].logo, '_verband_logo', logo_options) %}
          {% if image %}
            <h2>{% with {figure: image} %}{{ block('figure_component') }}{% endwith %}</h2>
              {% else %}
             <h2 class="mt-5 mb-4">{{ verbaende[verbandId].name }}</h2>
          {% endif %}
    {% else %}
       <h2 class="mt-5 mb-4">{{ verbaende[verbandId].name }}</h2>
    {% endif %}

    {% for ligaId, mannschaften in ligen %}
      <div class="row">

          <div class="col-12">
              <h3>
                  {{ ligenmapping[ligaId] }}
              </h3>
          </div>

          <div class="col-12">
            <ul>
              {% for name in mannschaften %}
                  <li>{{ name|raw }}</li>
              {% endfor %}
            </ul>
          </div>

        </div>
    {% endfor %}

  {% endfor %}

{% endblock %}
